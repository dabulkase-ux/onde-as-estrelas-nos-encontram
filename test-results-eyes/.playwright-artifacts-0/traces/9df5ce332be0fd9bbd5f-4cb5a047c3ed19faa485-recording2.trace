ate}.ambient-halo{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 46%,#26304227 0%,#151d2818 30%,transparent 62%),radial-gradient(ellipse at 25% 10%,#2c273720,transparent 40%)}.grain{position:absolute;inset:0;opacity:.055;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.4' d='M0 0h180v180H0z'/%3E%3C/svg%3E\")}.site-header{position:absolute;top:0;left:0;right:0;padding:calc(30px + env(safe-area-inset-top)) 42px 0;display:flex;justify-content:space-between;align-items:center;z-index:5}.wordmark{display:flex;align-items:center;gap:12px;font-family:Georgia,serif;font-size:19px;letter-spacing:-.4px}.wordmark svg{color:var(--gold)}.wordmark>span{margin:0 8px;color:#5d5a56;font-size:17px}.wordmark small{font:11px Arial,sans-serif;letter-spacing:1.2px;color:#8f9098}.sound-toggle{border:1px solid #ffffff15;border-radius:50%;background:#ffffff03;display:flex;gap:3px;width:42px;height:42px;justify-content:center;align-items:center}.sound-toggle span{height:5px;width:1px;background:#c6bba7;transition:height .3s}.sound-on span:nth-child(2){height:15px}.sound-on span:nth-child(3){height:10px}.sound-on span:nth-child(4){height:7px}.scene{text-align:center}.eyebrow{font-size:10px;font-weight:500;letter-spacing:3.4px;color:var(--gold);margin-bottom:18px}.subtitle{font-size:13px;line-height:1.6;color:#9899a1;margin-top:18px;letter-spacing:.1px}.lock-scene{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(100%,430px);padding:0 20px;margin-top:5px}.lock-heading{animation:appear 1.5s both}.lock-art{position:relative;width:216px;height:175px;margin:16px auto 7px;display:flex;justify-content:center;align-items:center}.padlock{width:89px;height:112px;z-index:2;filter:drop-shadow(0 8px 13px #0008);transition:filter 1s}.shackle{transform-origin:35px 67px;transition:transform 1.2s cubic-bezier(.22,.8,.25,1)}.lock-aura{position:absolute;inset:8px;background:radial-gradient(ellipse,#c8a87914,transparent 66%);transition:transform 2s,opacity 2s}.orbit{border:1px solid #cbb28c12;border-radius:50%;position:absolute;width:176px;height:176px}.orbit-one{width:144px;height:144px}.orbit-two:after{content:'';position:absolute;inset:-15px;border:1px dashed #cbb28c0a;border-radius:50%}.orbit-star{position:absolute;color:#cbb28c99;font-size:13px}.star-one{top:24px;right:43px}.star-two{left:32px;bottom:29px;font-size:9px}.pin-dots{display:flex;gap:20px;justify-content:center;height:20px;align-items:center}.pin-dots span{width:9px;height:9px;border-radius:50%;border:1px solid #b8a88a55;transition:background .2s,box-shadow .2s,transform .2s}.pin-dots .filled{background:#e0c8a1;border-color:#e0c8a1;box-shadow:0 0 15px #d9b57b66;transform:scale(1.12)}.pin-message{height:46px;display:flex;justify-content:center;align-items:center;font-size:11px;line-height:1.5;letter-spacing:.2px;color:#98959a;max-width:300px;margin:auto}.pin-message.has-message{color:#d3bd9e}.keypad{width:252px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px 14px;margin:3px auto 0}.keypad button{height:49px;background:linear-gradient(155deg,#ffffff05,#ffffff01);border:1px solid #ffffff0b;border-radius:12px;font-size:21px;font-weight:300;transition:background .18s,transform .18s,border-color .18s}.keypad button:active{transform:scale(.93);background:#cbb28c15;border-color:#cbb28c50}.keypad .key-utility{border-color:transparent;background:none;font-size:16px;color:#8f8e93;display:flex;justify-content:center;align-items:center}.key-utility:first-of-type{font-family:Georgia,serif}.site-footer{position:absolute;bottom:calc(28px + env(safe-area-inset-bottom));left:42px;right:42px;display:flex;align-items:center;justify-content:space-between;gap:20px;z-index:3}.footer-note,.footer-coordinate{font-size:9px;letter-spacing:2px;col