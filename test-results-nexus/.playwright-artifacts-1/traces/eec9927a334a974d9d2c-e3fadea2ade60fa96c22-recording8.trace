;height:144px}.orbit-two:after{content:'';position:absolute;inset:-15px;border:1px dashed #cbb28c0a;border-radius:50%}.orbit-star{position:absolute;color:#cbb28c99;font-size:13px}.star-one{top:24px;right:43px}.star-two{left:32px;bottom:29px;font-size:9px}.pin-dots{display:flex;gap:20px;justify-content:center;height:20px;align-items:center}.pin-dots span{width:9px;height:9px;border-radius:50%;border:1px solid #b8a88a55;transition:background .2s,box-shadow .2s,transform .2s}.pin-dots .filled{background:#e0c8a1;border-color:#e0c8a1;box-shadow:0 0 15px #d9b57b66;transform:scale(1.12)}.pin-message{height:46px;display:flex;justify-content:center;align-items:center;font-size:11px;line-height:1.5;letter-spacing:.2px;color:#98959a;max-width:300px;margin:auto}.pin-message.has-message{color:#d3bd9e}.keypad{width:252px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px 14px;margin:3px auto 0}.keypad button{height:49px;background:linear-gradient(155deg,#ffffff05,#ffffff01);border:1px solid #ffffff0b;border-radius:12px;font-size:21px;font-weight:300;transition:background .18s,transform .18s,border-color .18s}.keypad button:active{transform:scale(.93);background:#cbb28c15;border-color:#cbb28c50}.keypad .key-utility{border-color:transparent;background:none;font-size:16px;color:#8f8e93;display:flex;justify-content:center;align-items:center}.key-utility:first-of-type{font-family:Georgia,serif}.site-footer{position:absolute;bottom:calc(28px + env(safe-area-inset-bottom));left:42px;right:42px;display:flex;align-items:center;justify-content:space-between;gap:20px;z-index:3}.footer-note,.footer-coordinate{font-size:9px;letter-spacing:2px;color:#777780}.footer-coordinate{min-width:200px;text-align:right}.footer-note{min-width:200px}.chapters{list-style:none;padding:0;margin:0;display:flex;gap:30px;align-items:center}.chapters li{display:flex;gap:8px;align-items:center;position:relative;font-size:10px;letter-spacing:.6px;color:#686974}.chapter-number{font-size:9px;color:#73747d}.chap