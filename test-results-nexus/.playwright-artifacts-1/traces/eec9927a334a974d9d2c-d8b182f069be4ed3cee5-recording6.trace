{"type":"frame-snapshot","snapshot":{"callId":"call@2429","phase":"before","pageId":"page@6aca39b0ab592c09082ccdc27398cb56","frameId":"frame@7be5157a0424c137011cfdaee443c951","frameUrl":"http://localhost:5173/jardim-eterno/index.html","doctype":"html","html":["HTML",{"lang":"pt-BR"},[[494,15]],[[494,16]],["BODY",{"data-scene":"CONVENCIDO_FILE"},[[494,17]],["MAIN",{"id":"experience","aria-label":"Um jardim que cabe em um programa","data-scene":"CONVENCIDO_FILE"},[[494,18]],["DIV",{"id":"screen-layer"},[[494,19]],[[494,20]],[[494,21]],[[494,22]],[[494,23]],[[184,0]],[[494,35]],[[184,1]],[[494,37]],[[184,2]],[[494,39]],[[494,43]],[[494,44]],[[176,0]],[[494,46]],[[8,1]],[[494,81]],[[219,18]],[[494,96]],[[494,106]],[[494,107]],[[184,3]],[[494,115]],[[183,0]],[[494,118]],["SECTION",{"id":"file","class":"file-window","aria-labelledby":"file-title"},[[494,119]],[[2,1]],[[494,127]],[[9,7]],[[494,132]],[[306,8]],[[494,135]]],[[494,137]]],[[494,139]],[[494,141]],[[494,142]],[[494,261]],[[494,262]]],[[494,264]],[[494,265]],[[494,266]],[[494,267]],[[494,268]],[[494,269]],[[494,270]]]],"viewport":{"width":430,"height":740},"timestamp":190459.255,"wallTime":1791744909672,"collectionTime":1.3999999910593033,"resourceOverrides":[],"isMainFrame":true}}
